{
  "name": "grannyflatchecklist",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  // Keep variables set in the Cloudflare dashboard (PAYWALL etc.) on every deploy.
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
